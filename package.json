{
  "name": "rehearsal",
  "displayName": "Rehearsal",
  "description": "See whether database changes are ready for a safe local rehearsal without memorizing CLI commands.",
  "version": "0.1.10",
  "private": true,
  "publisher": "rehearsal-db",
  "license": "SEE LICENSE IN LICENSE",
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#17252e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ddupasquier/rehearsal-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Ddupasquier/rehearsal-db/issues"
  },
  "homepage": "https://ddupasquier.github.io/rehearsal-db/",
  "icon": "media/rehearsal-readme.png",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22 <27"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Rehearsal shows static guidance only and runs no workspace process until the folder is trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Rehearsal requires a local project and its workspace-installed CLI."
    }
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "postgresql",
    "supabase",
    "database",
    "migrations",
    "testing"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onView:rehearsal.projects",
    "onCommand:rehearsal.refresh",
    "onCommand:rehearsal.checkUpdates",
    "onCommand:rehearsal.configureUpdateChecks",
    "onCommand:rehearsal.openWorkspace",
    "onCommand:rehearsal.openPrivacy",
    "onCommand:rehearsal.openSupport",
    "onCommand:rehearsal.openLicense",
    "onCommand:rehearsal.resetLocalState",
    "onCommand:rehearsal.workspaceAction",
    "onCommand:rehearsal.treeAction",
    "workspaceContains:rehearsal.config.mjs",
    "workspaceContains:**/rehearsal.config.mjs",
    "workspaceContains:node_modules/@rehearsal-db/core/package.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rehearsal",
          "title": "Rehearsal",
          "icon": "media/rehearsal.svg"
        }
      ]
    },
    "views": {
      "rehearsal": [
        {
          "id": "rehearsal.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rehearsal.projects",
        "contents": "Open a local project to see whether its database changes are ready.\n[Open Rehearsal Workspace](command:rehearsal.openWorkspace)\n[Read the getting-started guide](command:rehearsal.openDocumentation)"
      }
    ],
    "walkthroughs": [
      {
        "id": "rehearsal.getStarted",
        "title": "Get started with Rehearsal",
        "description": "Understand your project, create a safe local baseline, and test database changes before deployment.",
        "steps": [
          {
            "id": "open-project",
            "title": "Open your application project",
            "description": "Open the folder that contains `package.json` and your database migrations. Rehearsal never borrows a package from another repository."
          },
          {
            "id": "open-workspace",
            "title": "Open the Rehearsal workspace",
            "description": "[Open Project Workspace](command:rehearsal.openWorkspace) to see detected facts, suggestions, decisions, migration state, and local runtime status."
          },
          {
            "id": "follow-next-step",
            "title": "Follow the next best step",
            "description": "Use the primary action on Overview. Installs, updates, migrations, resets, and cleanup always show an explicit confirmation or Rehearsal's own guided review."
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "rehearsal.checkUpdates",
        "title": "Rehearsal: Check for Updates",
        "icon": "$(cloud-download)"
      },
      {
        "command": "rehearsal.configureUpdateChecks",
        "title": "Rehearsal: Configure Update Checks"
      },
      {
        "command": "rehearsal.refresh",
        "title": "Rehearsal: Refresh Project Overview",
        "icon": "$(refresh)"
      },
      {
        "command": "rehearsal.openWorkspace",
        "title": "Rehearsal: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "rehearsal.openDocumentation",
        "title": "Rehearsal: Open Documentation"
      },
      {
        "command": "rehearsal.openPrivacy",
        "title": "Rehearsal: View Privacy and Data Use"
      },
      {
        "command": "rehearsal.openSupport",
        "title": "Rehearsal: View Support Policy"
      },
      {
        "command": "rehearsal.openLicense",
        "title": "Rehearsal: View License Terms"
      },
      {
        "command": "rehearsal.resetLocalState",
        "title": "Rehearsal: Reset Saved Editor State"
      },
      {
        "command": "rehearsal.showCliCommand",
        "title": "Rehearsal: Show Equivalent CLI Command"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rehearsal.openWorkspace",
          "when": "view == rehearsal.projects",
          "group": "navigation@1"
        },
        {
          "command": "rehearsal.refresh",
          "when": "view == rehearsal.projects",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Rehearsal",
      "properties": {
        "rehearsal.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Optional project-relative path passed to Rehearsal as `--config=<path>`. Leave empty to use the CLI's fail-closed discovery."
        },
        "rehearsal.inspectionTimeoutSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 15,
          "maximum": 300,
          "scope": "resource",
          "markdownDescription": "Maximum time for each read-only Rehearsal inspection command. Increase this only when a large local project needs more time; the extension still cancels only processes it owns."
        },
        "rehearsal.openDashboardAutomatically": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Open the Rehearsal dashboard automatically once when a trusted single-folder project is first inspected in this VS Code window. Disable this when you prefer to open it from the Rehearsal sidebar or Command Palette."
        }
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "tsx scripts/preview-workspace.ts",
    "test:lab": "tsx scripts/verify-test-lab.ts",
    "verify:vsix": "tsx scripts/verify-private-vsix.ts",
    "verify:controller": "tsx scripts/verify-packaged-controller.ts",
    "commercial:verify": "tsx scripts/verify-commercial-readiness.ts",
    "package:vsix": "npm run build && vsce package",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:controller && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.0.0",
    "prettier": "^3.9.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
